<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             id="Definitions_1">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1" name="Bestellung eingegangen" />
    <task id="Task_1" name="Zahlung prüfen" />
    <task id="Task_2" name="Ware versenden" />
    <task id="Task_3" name="Rechnung erstellen" camunda:class="org.example.DummyDelegate" />
    <endEvent id="EndEvent_1" name="Bestellung abgeschlossen" />

    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="EndEvent_1" />
  </process>
</definitions>